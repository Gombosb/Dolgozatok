<Window x:Class="Dolgozatok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dolgozatok"
        mc:Ignorable="d"
        Title="Dolgozatok" Height="450" Width="800">
    <DockPanel>
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="Dtgrid"
                  Grid.Row="0"
                  ItemsSource="{Binding Dolgozatok}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  Margin="0,0,0,28">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Név"
                                    Binding="{Binding Nev}"
                                    Width="*"/>

                    <DataGridTextColumn Header="Életkor"
                                    Binding="{Binding Eletkor}"
                                    Width="90"/>

                    <DataGridTextColumn Header="Pontszám"
                                    Binding="{Binding Pontszam}"
                                    Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="1" Margin="0,6,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Név:" VerticalAlignment="Center" Padding="5,0,8,0"/>

                <TextBox x:Name="txtNev" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="0,0,14,0"/>

                <Label Grid.Column="2" Content="Életkor:" VerticalAlignment="Center" Padding="5,0,8,0"/>

                <TextBox x:Name="txtEletkor" Grid.Column="3" Height="32" VerticalContentAlignment="Center" Margin="0,0,14,0"/>

                <Label Grid.Column="4" Content="Pontszám:" VerticalAlignment="Center" Padding="5,0,8,0"/>

                <TextBox x:Name="txtPontszam" Grid.Column="5" Height="32" VerticalContentAlignment="Center"/>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">

                <Button Content="Hozzáadás" Width="125" Height="40" Margin="0,0,12,0" Click="Hozzaadas_Click"/>

                <Button Content="Mentés" Width="125" Height="40" Click="Mentes_Click"/>

            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
